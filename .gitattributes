# Нормализация окончаний строк: в репозитории всегда LF,
# независимо от ОС разработчика (защита от CRLF-шума в diff).
* text=auto eol=lf

# Windows-скрипты требуют CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Бинарные файлы — не трогать
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
