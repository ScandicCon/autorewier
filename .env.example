# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/autorewier.db
RUN_ALEMBIC_ON_STARTUP=false
ENVIRONMENT=development
APP_VERSION=0.2.0
APP_REVISION=

# Web
WEB_SECRET_KEY=generate-long-random-string
WEB_BASE_URL=http://127.0.0.1:8000
WEB_SESSION_TTL_SECONDS=2592000
WEB_COOKIE_SECURE=false
WEB_COOKIE_SAMESITE=lax
WEB_COOKIE_DOMAIN=
ENFORCE_VERIFIED_ACCOUNTS=false
REQUIRE_EMAIL_VERIFICATION=false
VERIFICATION_CODE_TTL_MINUTES=15

# SMTP для email-подтверждения аккаунта
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=AutoRewier
SMTP_USE_TLS=true

# OpenRouter — углублённый анализ (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=AutoRewier

# Whisper — транскрипция голосовых сообщений (через OpenRouter)
# Требует OPENROUTER_API_KEY. Endpoint: https://openrouter.ai/api/v1/audio/transcriptions
WHISPER_MODEL=openai/whisper-1

# API
API_HOST=0.0.0.0
API_PORT=8000
# Хост-порт docker compose (наружу): ${APP_PORT}:8000
APP_PORT=8000

# Autocode B2B (https://b2bapi.avtocod.ru)
AUTOCODE_USER=your_user
AUTOCODE_PASSWORD=your_password
AUTOCODE_DOMAIN=your_domain
AUTOCODE_REPORT_TYPE_UID=report_type_uid@your_domain

# YooKassa (https://yookassa.ru)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://127.0.0.1:8000/cabinet/subscription?paid=1
YOOKASSA_WEBHOOK_ALLOWLIST=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.154.128/25,77.75.156.11/32,77.75.156.35/32,2a02:5180::/32
ALLOW_DEV_PAYMENT_BYPASS=false
ALLOW_MOCK_SERVICES=false

# Header-based Telegram auth for API (off by default)
ENABLE_TELEGRAM_HEADER_AUTH=true
TELEGRAM_HEADER_SECRET=

# Admin / support API
ADMIN_API_TOKEN=
STRICT_PRODUCTION_CHECKS=true

SUBSCRIPTION_PRO_PRICE_RUB=990
FREE_INSPECTIONS_PER_MONTH=3

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_PAYMENT_LIMIT=20
RATE_LIMIT_PAYMENT_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_LIMIT=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_VIN_LIMIT=30
RATE_LIMIT_VIN_WINDOW_SECONDS=60

# Observability
JSON_LOGS=true
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Avito: auto = Playwright, затем httpx
AVITO_FETCH_MODE=auto
AVITO_FETCH_TIMEOUT_MS=45000
AVITO_FETCH_RETRY_ATTEMPTS=2
AVITO_FETCH_RETRY_BACKOFF_SEC=1.2
AVITO_FETCH_TIME_BUDGET_SEC=90
AVITO_CAPTCHA_RETRY_ATTEMPTS=1
AVITO_PLAYWRIGHT_HEADLESS=true
AVITO_CACHE_ENABLED=true
AVITO_CACHE_TTL_SEC=3600
AVITO_BROWSER_PER_REQUEST=true
# AVITO_BROWSER_PER_REQUEST=false — один браузер с cookies (профиль ниже)
# AVITO_USER_DATA_DIR=./data/avito_browser_profile
# AVITO_PROXY=http://127.0.0.1:8080
# AVITO_PROXY_USERNAME=
# AVITO_PROXY_PASSWORD=

# VPS / домен (для docker-compose.vps.yml)
APP_DOMAIN=

# Redis / workers (optional)
REDIS_URL=
TASK_QUEUE_ENABLED=false
TASK_QUEUE_NAME=autorewier:tasks

# Мониторинг объявлений — интервал проверки в секундах (по умолчанию 3600 = 1 час)
MONITORING_CYCLE_INTERVAL_SECONDS=3600

# --- PostHog (продуктовая аналитика) ---
# Публичный project key (phc_...). Регион: eu или us — смотри URL кабинета.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
