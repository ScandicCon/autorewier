# Каноничный хост — www (совпадает с canonical, sitemap и Вебмастером).
# Caddy сам получает и продлевает Let's Encrypt-сертификаты.

www.{$APP_DOMAIN} {
  encode zstd gzip
  reverse_proxy api:8000
}

# Apex 301-редиректом на www, чтобы не плодить дубли для поисковиков.
{$APP_DOMAIN} {
  redir https://www.{$APP_DOMAIN}{uri} permanent
}
